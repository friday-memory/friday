FROM python:3.11-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake curl ca-certificates && rm -rf /var/lib/apt/lists/*
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
WORKDIR /build
COPY requirements-serverless.txt .
RUN CARGO_BUILD_JOBS=2 pip wheel --wheel-dir /wheels -r requirements-serverless.txt

FROM python:3.11-slim
WORKDIR /app
COPY --from=builder /wheels /wheels
COPY requirements-serverless.txt .
RUN pip install --no-index --find-links=/wheels -r requirements-serverless.txt && rm -rf /wheels && useradd --uid 10001 --create-home friday
COPY gateway /app/gateway
COPY storage /app/storage
COPY migrations /app/migrations
COPY layers /app/layers
COPY orchestrator /app/orchestrator
COPY pipelines /app/pipelines
COPY scripts /app/scripts
RUN chmod -R a+rX /app
USER 10001
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn gateway.serverless:create_app --factory --host 0.0.0.0 --port ${PORT} --no-access-log"]
