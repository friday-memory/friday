# ==============================================================================
# Friday — Self-Hosted Configuration
# ==============================================================================

# 1. Friday Server Security (Set your own secret password to protect your server)
FRIDAY_API_KEY=choose_any_secret_password_you_want

# 2. LLM for Autonomous Graph Extraction (Extracts nodes & edges from memories)
# Get a key at: https://platform.deepseek.com (~$0.14/M tokens)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 3. Semantic Memory Layer (Mem0)
# Get a free key at: https://mem0.ai
MEM0_API_KEY=m0-your_mem0_api_key_here

# 4. Knowledge Graph Database (Neo4j - bundled in docker-compose)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=choose_a_strong_password_here

# 5. Server Options
HOST=0.0.0.0
PORT=8000
